spring.application.name=adminrabbit

server.port=8081

spring.security.oauth2.resourceserver.jwt.issuer-uri=https://login.microsoftonline.com/TU_TENANT_ID_AZURE/v2.0
spring.security.oauth2.resourceserver.jwt.audiences=TU_CLIENT_ID_AZURE

spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USER:guest}
spring.rabbitmq.password=${RABBITMQ_PASS:guest}
